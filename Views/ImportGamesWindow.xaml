<Window x:Class="GameLauncher.ImportGamesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:GameLauncher.Services.Localization"
        xmlns:conv="clr-namespace:GameLauncher.Converters"
        Title="{loc:Loc Key=Import.Title}" Icon="pack://application:,,,/Resources/Images/game.ico"
        Height="520" Width="660" MinHeight="400" MinWidth="620"
        Background="#1E1E1E" Foreground="White"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <conv:ProgramIconConverter x:Key="ProgramIcon"/>

        <!-- Modern Base Button Template -->
        <Style x:Key="ModernWindowButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ModernWindowButton}">
            <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.7"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ModernWindowButton}">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="BorderBrush" Value="#3E3E42"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3E3E42"/>
                    <Setter Property="BorderBrush" Value="#555555"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#1A1A1C"/>
                    <Setter Property="BorderBrush" Value="#2D2D30"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Beschreibung -->
            <RowDefinition Height="Auto"/> <!-- Suche und Umschalter -->
            <RowDefinition Height="Auto"/> <!-- Status -->
            <RowDefinition Height="*"/>    <!-- Liste -->
            <RowDefinition Height="Auto"/> <!-- Buttons -->
        </Grid.RowDefinitions>

        <TextBlock Text="{loc:Loc Key=Import.Header}" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,0,0,6"/>

        <TextBlock Grid.Row="1" Text="{loc:Loc Key=Import.Description}" FontSize="12" Foreground="#888888"
                   TextWrapping="Wrap" Margin="0,0,0,12"/>

        <!-- Suche und Umschalter -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid>
                <TextBox x:Name="SearchBox" Padding="8,6" Background="#252526" Foreground="White"
                         BorderBrush="#3E3E42" BorderThickness="1" FontSize="13"
                         VerticalContentAlignment="Center"
                         TextChanged="SearchBox_TextChanged"/>
                <TextBlock Text="{loc:Loc Key=Import.SearchPlaceholder}" Foreground="#777777" FontSize="13"
                           Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <CheckBox x:Name="ShowAllProgramsBox" Grid.Column="1" Margin="15,0,0,0"
                      VerticalAlignment="Center" Foreground="#CCCCCC" FontSize="12"
                      Content="{loc:Loc Key=Import.ShowAllPrograms}"
                      ToolTip="{loc:Loc Key=Import.ShowAllProgramsTooltip}"
                      Checked="ShowAllPrograms_Changed" Unchecked="ShowAllPrograms_Changed"/>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="3" FontSize="12" Foreground="#CCCCCC"
                   TextWrapping="Wrap" Margin="0,0,0,10"/>

        <Border Grid.Row="4" Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="5">
            <ListBox x:Name="CandidateList" Background="Transparent" BorderThickness="0" Foreground="White"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Padding" Value="8,7"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}"
                                            BorderBrush="#2F2F33" BorderThickness="0,0,0,1">
                                        <ContentPresenter/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2D2D30"/>
                            </Trigger>
                            <!-- Nach dem Hover-Auslöser, damit die Auswahl sichtbar bleibt -->
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Background" Value="#2B3440"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalContentAlignment="Center" Foreground="White">
                            <Grid Margin="10,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Programmsymbol: gibt der Liste einen Ankerpunkt -->
                                <Border Width="32" Height="32" VerticalAlignment="Center" Margin="0,0,12,0"
                                        Background="#33000000" CornerRadius="4">
                                    <Image Source="{Binding TargetPath, Converter={StaticResource ProgramIcon}}"
                                           Width="22" Height="22" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="#F0F0F0" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding TargetPath}" FontSize="10" Foreground="#6E6E6E"
                                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding TargetPath}"/>
                                </StackPanel>

                                <!-- Kennzeichnet Eintraege, die nur ueber die vollstaendige Liste sichtbar sind -->
                                <Border Grid.Column="2" VerticalAlignment="Center" Margin="10,0,4,0"
                                        Background="#3A3A3E" CornerRadius="3" Padding="7,2">
                                    <TextBlock Text="{loc:Loc Key=Import.ProgramBadge}" FontSize="10" Foreground="#A0A0A0"/>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLikelyGame}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </Grid>
                        </CheckBox>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!--
            Zwei Spalten statt einer gemeinsamen Zelle: Lagen beide Gruppen in
            derselben Zelle und waren nur unterschiedlich ausgerichtet, wussten sie
            nichts voneinander und schoben sich bei knapper Breite übereinander.
            Die rechte Gruppe bekommt ihre natürliche Breite, die linke den Rest.
        -->
        <Grid Grid.Row="5" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="SelectAllButton" Content="{loc:Loc Key=Import.SelectAll}" Style="{StaticResource SecondaryButton}"
                        Click="SelectAll_Click" MinWidth="120" Margin="0,0,10,0"/>
                <Button x:Name="SelectNoneButton" Content="{loc:Loc Key=Import.SelectNone}" Style="{StaticResource SecondaryButton}"
                        Click="SelectNone_Click" MinWidth="120"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="15,0,0,0">
                <Button Content="{loc:Loc Key=Common.Cancel}" Style="{StaticResource SecondaryButton}"
                        Click="Cancel_Click" Margin="0,0,10,0" MinWidth="110"/>
                <Button x:Name="ConfirmButton" Content="{loc:Loc Key=Import.Confirm}" Style="{StaticResource PrimaryButton}"
                        Click="Confirm_Click" MinWidth="110"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
