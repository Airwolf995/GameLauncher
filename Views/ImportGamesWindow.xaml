<Window x:Class="GameLauncher.ImportGamesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:GameLauncher.Services.Localization"
        Title="{loc:Loc Key=Import.Title}" Icon="pack://application:,,,/Resources/Images/game.ico"
        Height="520" Width="560" MinHeight="400" MinWidth="480"
        Background="#1E1E1E" Foreground="White"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <!-- Modern Base Button Template -->
        <Style x:Key="ModernWindowButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ModernWindowButton}">
            <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.7"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ModernWindowButton}">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="BorderBrush" Value="#3E3E42"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3E3E42"/>
                    <Setter Property="BorderBrush" Value="#555555"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#1A1A1C"/>
                    <Setter Property="BorderBrush" Value="#2D2D30"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Beschreibung -->
            <RowDefinition Height="Auto"/> <!-- Status -->
            <RowDefinition Height="*"/>    <!-- Liste -->
            <RowDefinition Height="Auto"/> <!-- Buttons -->
        </Grid.RowDefinitions>

        <TextBlock Text="{loc:Loc Key=Import.Header}" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,0,0,6"/>

        <TextBlock Grid.Row="1" Text="{loc:Loc Key=Import.Description}" FontSize="12" Foreground="#888888"
                   TextWrapping="Wrap" Margin="0,0,0,12"/>

        <TextBlock x:Name="StatusText" Grid.Row="2" FontSize="12" Foreground="#CCCCCC"
                   TextWrapping="Wrap" Margin="0,0,0,10"/>

        <Border Grid.Row="3" Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="5">
            <ListBox x:Name="CandidateList" Background="Transparent" BorderThickness="0" Foreground="White"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Padding" Value="4"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2D2D30"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalContentAlignment="Center" Foreground="White">
                            <StackPanel Margin="6,0,0,0">
                                <TextBlock Text="{Binding Name}" FontSize="13" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding TargetPath}" FontSize="11" Foreground="#777777" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </CheckBox>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Grid Grid.Row="4" Margin="0,15,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="SelectAllButton" Content="{loc:Loc Key=Import.SelectAll}" Style="{StaticResource SecondaryButton}"
                        Click="SelectAll_Click" MinWidth="120" Margin="0,0,10,0"/>
                <Button x:Name="SelectNoneButton" Content="{loc:Loc Key=Import.SelectNone}" Style="{StaticResource SecondaryButton}"
                        Click="SelectNone_Click" MinWidth="120"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{loc:Loc Key=Common.Cancel}" Style="{StaticResource SecondaryButton}"
                        Click="Cancel_Click" Margin="0,0,10,0" MinWidth="110"/>
                <Button x:Name="ConfirmButton" Content="{loc:Loc Key=Import.Confirm}" Style="{StaticResource PrimaryButton}"
                        Click="Confirm_Click" MinWidth="110"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
