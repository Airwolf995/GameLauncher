<Window x:Class="GameLauncher.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:GameLauncher.ViewModels"
        xmlns:loc="clr-namespace:GameLauncher.Services.Localization"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
        Title="{loc:Loc Key=Settings.Title}" Icon="pack://application:,,,/Resources/Images/game.ico" Height="720" Width="820"
        MinHeight="520" MinWidth="700"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E" Foreground="White"
        Opacity="0"
        ResizeMode="CanResize">

    <Window.Resources>
        <!-- Styles moved to App.xaml -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!--
            Eintrag der Kategorienleiste: flach, mit einem Akzentbalken links am
            ausgewaehlten Eintrag. Ein eigenes Template ist noetig, weil das
            Standardaussehen der ListBox hell ist und nicht zum Fenster passt.
        -->
        <Style x:Key="SettingsCategoryItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="AccentBar" Background="Transparent"/>
                            <Border x:Name="Hover" Grid.Column="1" Background="Transparent">
                                <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Background" Value="#33FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="AccentBar" Property="Background" Value="{DynamicResource AccentColor}"/>
                                <Setter TargetName="Hover" Property="Background" Value="#22FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Zeilenbeschriftung links neben dem jeweiligen Bedienelement -->
        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Zwischenueberschrift innerhalb einer Kategorie -->
        <Style x:Key="SettingGroupCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="SettingHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="SettingRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="CategoryPage" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Padding" Value="0,0,15,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Kategorienleiste -->
        <Border Background="#252526" BorderBrush="#333333" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="{loc:Loc Key=Settings.Title}" FontSize="20" FontWeight="Bold" Foreground="White"
                           Margin="20,24,20,20"/>

                <ListBox x:Name="CategoryList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource SettingsCategoryItem}"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectedIndex="0"
                         SelectionChanged="CategoryList_SelectionChanged">
                    <ListBoxItem Tag="Appearance" Content="{loc:Loc Key=Settings.CategoryAppearance}"/>
                    <ListBoxItem Tag="Behavior" Content="{loc:Loc Key=Settings.CategoryBehavior}"/>
                    <ListBoxItem Tag="Overlay" Content="{loc:Loc Key=Settings.CategoryOverlay}"/>
                    <ListBoxItem Tag="Libraries" Content="{loc:Loc Key=Settings.CategoryLibraries}"/>
                    <ListBoxItem Tag="Updates" Content="{loc:Loc Key=Settings.CategoryUpdates}"/>
                    <ListBoxItem Tag="Backup" Content="{loc:Loc Key=Settings.CategoryBackup}"/>
                    <ListBoxItem Tag="About" Content="{loc:Loc Key=Settings.CategoryAbout}"/>
                </ListBox>
            </Grid>
        </Border>

        <!-- Inhalt der gewaehlten Kategorie -->
        <Grid Grid.Column="1" Margin="30,24,30,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="{Binding SelectedItem.Content, ElementName=CategoryList}"
                       FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,0,0,20"/>

            <Grid Grid.Row="1" Margin="0,0,0,20">

                <!-- Erscheinungsbild -->
                <ScrollViewer Style="{StaticResource CategoryPage}"
                              Visibility="{Binding SelectedItem.Tag, ElementName=CategoryList, Converter={StaticResource TagMatchToVisibilityConverter}, ConverterParameter=Appearance, FallbackValue=Collapsed}">
                    <StackPanel>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Loc Key=Settings.Theme}" Style="{StaticResource SettingLabel}"/>
                            <ComboBox x:Name="ThemeBox" Grid.Column="1" Width="200" HorizontalAlignment="Left"
                                      SelectedValuePath="Tag"
                                      SelectedValue="{Binding Appearance.SelectedTheme, Mode=TwoWay}">
                                <ComboBoxItem Content="{loc:Loc Key=Theme.Blue}" Tag="Blue"/>
                                <ComboBoxItem Content="{loc:Loc Key=Theme.Red}" Tag="Red"/>
                                <ComboBoxItem Content="{loc:Loc Key=Theme.Green}" Tag="Green"/>
                                <ComboBoxItem Content="{loc:Loc Key=Theme.Orange}" Tag="Orange"/>
                                <ComboBoxItem Content="{loc:Loc Key=Theme.Purple}" Tag="Purple"/>
                                <ComboBoxItem Content="{loc:Loc Key=Theme.Pink}" Tag="Pink"/>
                                <ComboBoxItem Content="{loc:Loc Key=Theme.Teal}" Tag="Teal"/>
                                <ComboBoxItem Content="{loc:Loc Key=Theme.White}" Tag="White"/>
                                <ComboBoxItem Content="{loc:Loc Key=Theme.Dark}" Tag="Dark"/>
                            </ComboBox>
                        </Grid>

                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Loc Key=Settings.Language}" Style="{StaticResource SettingLabel}"/>
                            <ComboBox Grid.Column="1" Width="200" HorizontalAlignment="Left" SelectedValuePath="Tag"
                                      SelectedValue="{Binding Appearance.SelectedLanguageCode, Mode=TwoWay}">
                                <ComboBoxItem Content="{loc:Loc Key=Language.English}" Tag="en"/>
                                <ComboBoxItem Content="{loc:Loc Key=Language.German}" Tag="de"/>
                            </ComboBox>
                        </Grid>

                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Loc Key=Settings.CardSize}" Style="{StaticResource SettingLabel}"/>
                            <ComboBox x:Name="CardSizeBox" Grid.Column="1" Width="200" HorizontalAlignment="Left"
                                      ItemsSource="{Binding Appearance.CardSizeOptions}" SelectedItem="{Binding Appearance.CardSize, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumLocalizationConverter}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>

                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Loc Key=Settings.ViewMode}" Style="{StaticResource SettingLabel}"/>
                            <ComboBox x:Name="ViewModeBox" Grid.Column="1" Width="200" HorizontalAlignment="Left"
                                      ItemsSource="{Binding Appearance.ViewModeOptions}" SelectedItem="{Binding Appearance.ViewMode, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumLocalizationConverter}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>

                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Loc Key=Settings.FontScale}" Style="{StaticResource SettingLabel}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Slider Width="200" Minimum="0.8" Maximum="1.4" TickFrequency="0.1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                        Value="{Binding Appearance.FontScale}"/>
                                <TextBlock Text="{Binding Appearance.FontScalePercentage}" Margin="15,0,0,0" VerticalAlignment="Center" FontSize="14" MinWidth="50"/>
                            </StackPanel>
                        </Grid>

                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Loc Key=Settings.Animations}" Style="{StaticResource SettingLabel}"/>
                            <CheckBox x:Name="AnimationsCheckBox" Grid.Column="1" Content="{loc:Loc Key=Settings.Enabled}" VerticalAlignment="Center" Foreground="#AAAAAA"
                                      IsChecked="{Binding Appearance.AnimationsEnabled}"/>
                        </Grid>

                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Loc Key=Settings.BackgroundImage}" Style="{StaticResource SettingLabel}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="{loc:Loc Key=Settings.SelectImage}" MinWidth="120" Padding="12,6" FontSize="12"
                                        ToolTip="{loc:Loc Key=Settings.SelectImageTooltip}" Command="{Binding SelectBackgroundCommand}"/>
                                <Button Content="✖" Width="26" Height="26" Margin="10,0,0,0" Padding="0" FontSize="10"
                                        ToolTip="{loc:Loc Key=Settings.ClearBackgroundTooltip}" Command="{Binding ClearBackgroundCommand}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- Verhalten -->
                <ScrollViewer Style="{StaticResource CategoryPage}"
                              Visibility="{Binding SelectedItem.Tag, ElementName=CategoryList, Converter={StaticResource TagMatchToVisibilityConverter}, ConverterParameter=Behavior, FallbackValue=Collapsed}">
                    <StackPanel>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Loc Key=Settings.Autostart}" Style="{StaticResource SettingLabel}"/>
                            <CheckBox x:Name="AutostartCheckBox" Grid.Column="1" Content="{loc:Loc Key=Settings.StartWithWindows}" VerticalAlignment="Center" Foreground="#AAAAAA"
                                      IsChecked="{Binding Behavior.AutostartEnabled}"/>
                        </Grid>

                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Loc Key=Settings.Behavior}" Style="{StaticResource SettingLabel}" VerticalAlignment="Top"/>
                            <StackPanel Grid.Column="1">
                                <CheckBox Content="{loc:Loc Key=Settings.MinimizeToTray}" VerticalAlignment="Center" Foreground="#AAAAAA" Margin="0,0,0,8"
                                          IsChecked="{Binding Behavior.MinimizeToTray}"/>
                                <CheckBox Content="{loc:Loc Key=Settings.MinimizeOnGameStart}" VerticalAlignment="Center" Foreground="#AAAAAA" Margin="0,0,0,8"
                                          IsChecked="{Binding Behavior.MinimizeOnGameStart}"/>
                                <CheckBox Content="{loc:Loc Key=Settings.CloseOnGameStart}" VerticalAlignment="Center" Foreground="#AAAAAA"
                                          IsChecked="{Binding Behavior.CloseOnGameStart}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- Overlay -->
                <ScrollViewer Style="{StaticResource CategoryPage}"
                              Visibility="{Binding SelectedItem.Tag, ElementName=CategoryList, Converter={StaticResource TagMatchToVisibilityConverter}, ConverterParameter=Overlay, FallbackValue=Collapsed}">
                    <StackPanel>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Loc Key=Settings.OverlayHotkey}" Style="{StaticResource SettingLabel}" VerticalAlignment="Top"/>
                            <StackPanel Grid.Column="1">
                                <WrapPanel Margin="0,0,0,8">
                                    <CheckBox Content="{loc:Loc Key=Settings.Ctrl}" VerticalAlignment="Center" Foreground="#AAAAAA" Margin="0,0,12,0"
                                              IsChecked="{Binding Behavior.OverlayHotkeyCtrl}"/>
                                    <CheckBox Content="{loc:Loc Key=Settings.Alt}" VerticalAlignment="Center" Foreground="#AAAAAA" Margin="0,0,12,0"
                                              IsChecked="{Binding Behavior.OverlayHotkeyAlt}"/>
                                    <CheckBox Content="{loc:Loc Key=Settings.Shift}" VerticalAlignment="Center" Foreground="#AAAAAA" Margin="0,0,12,0"
                                              IsChecked="{Binding Behavior.OverlayHotkeyShift}"/>
                                    <CheckBox Content="{loc:Loc Key=Settings.Win}" VerticalAlignment="Center" Foreground="#AAAAAA"
                                              IsChecked="{Binding Behavior.OverlayHotkeyWin}"/>
                                </WrapPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="{loc:Loc Key=Settings.Key}" VerticalAlignment="Center" FontSize="13" Foreground="#AAAAAA" Margin="0,0,10,0"/>
                                    <ComboBox Width="120" HorizontalAlignment="Left"
                                              ItemsSource="{Binding Behavior.OverlayHotkeyKeys}"
                                              SelectedItem="{Binding Behavior.OverlayHotkeyKey, Mode=TwoWay}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Behavior.OverlayHotkeyDisplayText}" FontSize="12" Foreground="#888888" Margin="0,0,0,4"/>
                                <TextBlock Text="{loc:Loc Key=Settings.HotkeyHint}" Style="{StaticResource SettingHint}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Loc Key=Settings.SensorSource}" Style="{StaticResource SettingLabel}" VerticalAlignment="Top"/>
                            <StackPanel Grid.Column="1">

                                <!--
                                    Statuszeile: Der Knopf steht unabhaengig vom Zustand immer an
                                    derselben Stelle, damit er beim Klicken nicht unter dem
                                    Mauszeiger verschwindet. Nur der Text daneben wechselt.
                                -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{loc:Loc Key=Settings.SensorSourceChecking}" FontSize="12" Foreground="#AAAAAA"
                                               TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0"
                                               Visibility="{Binding IsSensorSourceChecking, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                    <TextBlock Text="{loc:Loc Key=Settings.SensorSourceConnected}" FontSize="12" Foreground="#6FBF73"
                                               TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0"
                                               Visibility="{Binding IsSensorSourceConnected, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                    <TextBlock Text="{loc:Loc Key=Settings.SensorSourceMissing}" FontSize="12" Foreground="#C8A55A"
                                               TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0"
                                               Visibility="{Binding IsSensorSourceMissing, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                    <Button Grid.Column="1" Content="{loc:Loc Key=Settings.SensorSourceRecheck}" Padding="10,3"
                                            VerticalAlignment="Top"
                                            Command="{Binding RecheckSensorSourceCommand}"/>
                                </Grid>

                                <!-- Quelle fehlt: Erklärung und Anleitung -->
                                <StackPanel Margin="0,8,0,0"
                                            Visibility="{Binding IsSensorSourceMissing, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{loc:Loc Key=Settings.SensorSourceIntro}" FontSize="12" Foreground="#AAAAAA"
                                               TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <TextBlock Text="{loc:Loc Key=Settings.SensorSourceStep1}" FontSize="12" Foreground="#AAAAAA" TextWrapping="Wrap" Margin="0,0,0,3"/>
                                    <TextBlock Text="{loc:Loc Key=Settings.SensorSourceStep2}" FontSize="12" Foreground="#AAAAAA" TextWrapping="Wrap" Margin="0,0,0,3"/>
                                    <TextBlock Text="{loc:Loc Key=Settings.SensorSourceStep3}" FontSize="12" Foreground="#AAAAAA" TextWrapping="Wrap" Margin="0,0,0,3"/>
                                    <TextBlock Text="{loc:Loc Key=Settings.SensorSourceStep4}" FontSize="12" Foreground="#AAAAAA" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <TextBlock Text="{loc:Loc Key=Settings.SensorSourceNvidiaNote}" Style="{StaticResource SettingHint}" Margin="0,0,0,8"/>
                                    <Button Content="{loc:Loc Key=Settings.SensorSourceDownload}" Padding="12,5"
                                            HorizontalAlignment="Left"
                                            Command="{Binding OpenSensorSourceCommand}"/>
                                </StackPanel>

                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- Bibliotheken -->
                <ScrollViewer Style="{StaticResource CategoryPage}"
                              Visibility="{Binding SelectedItem.Tag, ElementName=CategoryList, Converter={StaticResource TagMatchToVisibilityConverter}, ConverterParameter=Libraries, FallbackValue=Collapsed}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Key=Settings.LibraryHint}" Style="{StaticResource SettingHint}" Margin="0,0,0,15"/>

                        <!-- Steam -->
                        <TextBlock Text="{loc:Loc Key=Wizard.SteamPaths}" FontSize="13" Margin="0,0,0,5"/>
                        <TextBox Height="60" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15"
                                 Text="{Binding Library.SteamPathsText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>

                        <!-- Epic -->
                        <TextBlock Text="{loc:Loc Key=Wizard.EpicPaths}" FontSize="13" Margin="0,0,0,5"/>
                        <TextBox Height="60" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15"
                                 Text="{Binding Library.EpicPathsText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>

                        <!-- Xbox -->
                        <TextBlock Text="{loc:Loc Key=Wizard.XboxPaths}" FontSize="13" Margin="0,0,0,5"/>
                        <TextBox Height="60" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15"
                                 Text="{Binding Library.XboxPathsText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>

                        <!-- GOG -->
                        <TextBlock Text="{loc:Loc Key=Wizard.GogPaths}" FontSize="13" Margin="0,0,0,5"/>
                        <TextBox IsReadOnly="True" IsTabStop="False" Height="60" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15"
                                 Text="{Binding Library.GogPathsText, Mode=OneWay}"/>

                        <!-- Ubisoft -->
                        <TextBlock Text="{loc:Loc Key=Wizard.UbisoftPaths}" FontSize="13" Margin="0,0,0,5"/>
                        <TextBox IsReadOnly="True" IsTabStop="False" Height="60" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15"
                                 Text="{Binding Library.UbisoftPathsText, Mode=OneWay}"/>

                        <!-- EA -->
                        <TextBlock Text="{loc:Loc Key=Wizard.EaPaths}" FontSize="13" Margin="0,0,0,5"/>
                        <TextBox IsReadOnly="True" IsTabStop="False" Height="60" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8"
                                 Text="{Binding Library.EaPathsText, Mode=OneWay}"/>

                        <TextBlock Text="{loc:Loc Key=Wizard.AutomaticPathHelp}" Style="{StaticResource SettingHint}" Margin="0,0,0,20"/>

                        <!-- SteamGridDB -->
                        <TextBlock Text="{loc:Loc Key=Settings.ApiKey}" FontSize="13" Margin="0,0,0,5"/>
                        <TextBox Background="#333333" Foreground="White" BorderBrush="#555555" Margin="0,0,0,20"
                                 Text="{Binding Library.SteamGridDbApiKey, UpdateSourceTrigger=PropertyChanged}"/>

                        <!-- Ignorierte Prozesse -->
                        <TextBlock Text="{loc:Loc Key=Settings.IgnoredProcesses}" Style="{StaticResource SettingGroupCaption}" Margin="0,0,0,5"/>
                        <TextBlock Text="{loc:Loc Key=Settings.IgnoredProcessesHint}" Style="{StaticResource SettingHint}" Margin="0,0,0,10"/>
                        <TextBox Height="100" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" Background="#333333" Foreground="White" BorderBrush="#555555"
                                 Text="{Binding Library.IgnoredProcessesText, UpdateSourceTrigger=LostFocus}"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Updates -->
                <ScrollViewer Style="{StaticResource CategoryPage}"
                              Visibility="{Binding SelectedItem.Tag, ElementName=CategoryList, Converter={StaticResource TagMatchToVisibilityConverter}, ConverterParameter=Updates, FallbackValue=Collapsed}">
                    <StackPanel>
                        <CheckBox Content="{loc:Loc Key=Settings.AutoCheckUpdates}" Foreground="#AAAAAA" Margin="0,0,0,15"
                                  IsChecked="{Binding Behavior.AutoCheckUpdates}"/>
                        <Button Content="{Binding UpdateButtonText}" HorizontalAlignment="Left" Padding="12,5"
                                Command="{Binding CheckUpdatesCommand}" IsEnabled="{Binding IsCheckingUpdates, Converter={StaticResource InverseBoolConverter}}"
                                Background="{DynamicResource AccentColor}" Foreground="{DynamicResource AccentForeground}" FontWeight="Bold" MinWidth="180"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Sicherung -->
                <ScrollViewer Style="{StaticResource CategoryPage}"
                              Visibility="{Binding SelectedItem.Tag, ElementName=CategoryList, Converter={StaticResource TagMatchToVisibilityConverter}, ConverterParameter=Backup, FallbackValue=Collapsed}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Key=Settings.BackupHint}" Style="{StaticResource SettingHint}" Margin="0,0,0,15"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{loc:Loc Key=Settings.ExportConfig}" Command="{Binding ExportConfigCommand}"
                                    Padding="12,5" Background="#333333" Foreground="White" FontSize="12" Margin="0,0,10,0"/>
                            <Button Content="{loc:Loc Key=Settings.ImportConfig}" Command="{Binding ImportConfigCommand}"
                                    Padding="12,5" Background="#333333" Foreground="White" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Über -->
                <ScrollViewer Style="{StaticResource CategoryPage}"
                              Visibility="{Binding SelectedItem.Tag, ElementName=CategoryList, Converter={StaticResource TagMatchToVisibilityConverter}, ConverterParameter=About, FallbackValue=Collapsed}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <Image Source="pack://application:,,,/Resources/Images/game.ico" Width="56" Height="56"
                                   VerticalAlignment="Top" Margin="0,0,16,0"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{loc:Loc Key=AppName}" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock Text="{Binding VersionText}" FontSize="13" Foreground="#AAAAAA" Margin="0,3,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="{loc:Loc Key=Settings.AboutTagline}" FontSize="13" Foreground="#CCCCCC"
                                   TextWrapping="Wrap" MaxWidth="420" HorizontalAlignment="Left" Margin="0,0,0,20"/>

                        <TextBlock Text="{loc:Loc Key=Settings.AboutCopyright}" FontSize="12" Foreground="#AAAAAA" Margin="0,0,0,6"/>
                        <TextBlock Text="{loc:Loc Key=Settings.AboutLicense}" FontSize="12" Foreground="#AAAAAA"
                                   TextWrapping="Wrap" MaxWidth="420" HorizontalAlignment="Left" Margin="0,0,0,20"/>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="{loc:Loc Key=Main.LicenseInfo}" Click="LicenseInfo_Click"
                                    Padding="12,5" Background="#333333" Foreground="White" FontSize="12" Margin="0,0,10,0"/>
                            <Button Content="{loc:Loc Key=Settings.AboutProjectPage}" Command="{Binding OpenProjectPageCommand}"
                                    Padding="12,5" Background="#333333" Foreground="White" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Fußzeile -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{loc:Loc Key=Settings.ResetDefaults}" Command="{Binding ResetToDefaultsCommand}"
                        Padding="12,5" Background="#333333" Foreground="White" Margin="0,0,10,0" FontSize="12"/>
                <Button Content="{loc:Loc Key=Settings.Done}" Command="{Binding CloseCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Width="85" Height="32" Background="{DynamicResource AccentColor}" FontWeight="Bold" FontSize="12" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
